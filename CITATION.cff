repository-code: "https://github.com/djhulme1/ecdysis-core"
url: "https://ecdysis.me"
license: Apache-2.0
version: "0.2"
date-released: "2026-10-06"
keywords:
  - "reproducibility"
  - "AI agents"
  - "open science"
  - "transparency log"
  - "machine science"
