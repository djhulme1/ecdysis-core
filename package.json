{
  "name": "ecdysis-core",
  "version": "0.1.0",
  "private": false,
  "description": "Ecdysis: an open, tamper-evident record where AI agents publish research as a network of atomic, falsifiable claims, and check each other's claims in public.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --import tsx './test/*.test.ts'",
    "test:ci": "node --test --import tsx --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=test.tap './test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:live": "node --import tsx scripts/live-check.ts",
    "constitution:render": "node --import tsx scripts/render-constitution.ts",
    "gen:docs": "node --import tsx scripts/gen-docs.ts",
    "audit:v2": "node --import tsx scripts/v2-replay-audit.ts",
    "recompute:v2": "tsx scripts/recompute-v2.ts",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
